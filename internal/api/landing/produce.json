  "retention": [
    {
      "table": "s3_access_log",
      "days": 30,
      "action": "delete",
      "holds": [
        "bucket",
        "object_key",
        "operation",
        "source_ip",
        "user_agent",
        "logged_at"
      ],
      "what": "The request log of your buckets: each request's bucket, object name, operation, client IP address and user agent."
    },
    {
      "table": "events",
      "days": 90,
      "action": "delete",
      "holds": [
        "type",
        "data",
        "created_at"
      ],
      "what": "API and dashboard events of the account."
    },
    {
      "table": "quota_usage_events",
      "days": 90,
      "action": "delete",
      "holds": [
        "operation",
        "bytes_delta",
        "object_key"
      ],
      "what": "Quota usage events (no longer written; older rows are purged)."
    },
    {
      "table": "stripe_events",
      "days": 90,
      "action": "delete",
      "holds": [
        "event_type",
        "data"
      ],
      "what": "Card payment provider event bodies (Stripe)."
    },
    {
      "table": "payment_events",
      "days": 90,
      "action": "delete",
      "holds": [
        "provider",
        "event_type",
        "data"
      ],
      "what": "Payment provider event bodies of every provider, except the record of a subscription still to be cancelled, kept until the account is erased."
    },
    {
      "table": "cdn_access_log",
      "days": 2,
      "action": "delete",
      "holds": [
        "bucket",
        "object_key",
        "country",
        "referer",
        "accessed_at"
      ],
      "what": "Public-link visits: object name, the visitor's country and referring page; no IP address. Rolled into daily counts, then purged."
    },
    {
      "table": "webhook_deliveries",
      "days": 30,
      "action": "delete",
      "holds": [
        "status",
        "response_code",
        "created_at"
      ],
      "what": "Webhook delivery attempts."
    },
    {
      "table": "webhook_outbox",
      "days": 30,
      "action": "delete",
      "holds": [
        "state",
        "attempts",
        "created_at"
      ],
      "what": "Finished webhook deliveries (a pending one is kept until it finishes)."
    },
    {
      "table": "waitlist_signups",
      "days": 90,
      "action": "scrub",
      "scrub": [
        "ip_address",
        "user_agent"
      ],
      "holds": [
        "email",
        "ip_address",
        "user_agent",
        "country"
      ],
      "what": "A waitlist sign-up's IP address and user agent are blanked; the sign-up itself is kept."
    }
  ],
  "exports_days": 7,
  "kept": [
    {
      "table": "audit_logs",
      "holds": [
        "action",
        "resource",
        "ip",
        "user_agent",
        "performed_by"
      ],
      "what": "The audit trail: key and password changes, sign-ins, account and operator actions, each with the client IP address and user agent. Kept for the life of the service; an account's own entries are removed when it is erased."
    }
  ],
  "backups": {
    "on_box_days": 7,
    "off_box_days": 30
  },
  "private_ssec": {
    "table": "object_head_cache",
    "holds": [
      {
        "column": "object_key",
        "what": "the object's name, as you wrote it"
      },
      {
        "column": "size_bytes",
        "what": "its size"
      },
      {
        "column": "etag",
        "what": "its ETag: for a file uploaded in one request, the MD5 of its plaintext"
      },
      {
        "column": "content_type",
        "what": "its content type"
      },
      {
        "column": "metadata",
        "what": "the metadata you attach (x-amz-meta-*)"
      },
      {
        "column": "ssec_key_md5",
        "what": "the MD5 of your key, so a request with a different key is refused"
      },
      {
        "column": "updated_at",
        "what": "when it was written"
      },
      {
        "column": "last_accessed",
        "what": "when it was last read"
      }
    ]
  },
  "admin_reads": {
    "requires_flag": "translog_admin_reads",
    "text": "Every time an operator reads a customer's metadata through the admin API or the admin dashboard, an entry is appended to our transparency log before the read is served. The entry names no customer: it carries a commitment only that customer can check."
  },
  "builds": {
    "requires_flag": "translog_public",
    "text": "Every server build we run is appended to our public transparency log."
  },
  "caveat": "No storage provider can promise that it will not be able to read in the future: a server can be changed to keep the keys it is sent, and an app can be changed to send a key away, from the day of the change. Encrypting with your own tools before you upload leaves nothing of ours to change."
}

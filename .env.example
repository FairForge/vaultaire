S3_ENDPOINT=https://s3-compatible-endpoint.example.com
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here
S3_BUCKET=data
S3_PREFIX=storage/vaultaire

# Stripe. Both keys are required together: the webhook route is mounted only
# when STRIPE_WEBHOOK_SECRET is set (an unsigned webhook would be an open door
# to subscription state — Review R10-01). Create the webhook endpoint in the
# Stripe dashboard PINNED TO API VERSION 2023-08-16 (the stripe-go v75 pin):
# stripe-go rejects events at any other version, so an endpoint left on the
# account default fails every delivery. Events: checkout.session.completed,
# customer.subscription.{created,updated,deleted}, invoice.payment_{succeeded,failed}.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe — whole-TB house checkout (docs/DASHBOARD_PLAN.md Phase 1). All six
# are required together; each is verified against internal/api/landing/prices.json
# at boot (recipe: internal/billing/CLAUDE.md). The page is gated by the
# quota_checkout feature flag (default off).
STRIPE_PRICE_STANDARD_ANNUAL=price_...
STRIPE_PRICE_STANDARD_MONTHLY=price_...
STRIPE_PRICE_VAULT_ANNUAL=price_...
STRIPE_PRICE_VAULT_MONTHLY=price_...
STRIPE_PRICE_PINHOT_ANNUAL=price_...
STRIPE_PRICE_PINHOT_MONTHLY=price_...

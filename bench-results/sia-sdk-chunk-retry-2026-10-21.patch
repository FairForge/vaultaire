+
+// errFundsExhausted marks a chunk failure where most host reads were refused
+// for lack of account funds: the indexer refills accounts every 5 minutes, so
+// such a chunk waits for a refill (fundsRetryBackoff, ~6 min in all) instead
+// of failing the download.
+var errFundsExhausted = errors.New("host accounts out of funds")
+
+var fundsRetryBackoff = []time.Duration{
+	15 * time.Second, 30 * time.Second, 60 * time.Second, 60 * time.Second,
+	60 * time.Second, 60 * time.Second, 60 * time.Second,
+	60 * time.Second, 60 * time.Second, 60 * time.Second, 60 * time.Second,
+}
+
+// isFundsErr reports whether a host refused an RPC for lack of account funds.
+func isFundsErr(err error) bool {
+	return err != nil && (errors.Is(err, proto4.ErrNotEnoughFunds) || strings.Contains(err.Error(), "not enough funds"))
+}
+
+// shortHostKey returns a short, log-friendly form of a host key.
+func shortHostKey(hk types.PublicKey) string {
+	str := hk.String()
+	if len(str) > 20 {
+		return str[:20]
+	}
+	return str
+}
+
+// sectorErrClass buckets a sector read error for the failure summary.
+func sectorErrClass(err error, timedOut bool) string {
+	switch {
+	case timedOut:
+		return "host_timeout"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "deadline"
+	case errors.Is(err, context.Canceled):
+		return "canceled"
+	}
+	msg := err.Error()
+	if len(msg) > 64 {
+		msg = msg[:64]
+	}
+	return msg
+}

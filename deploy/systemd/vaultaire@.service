# Vaultaire as two slots behind HAProxy (docs/STATUS.md item 4, 2026-10-06;
# docs/DEPLOY.md "Zero-downtime deploys"): vaultaire@8000 ("blue") and
# vaultaire@8001 ("green"), ONE active at a time. A deploy installs the new
# binary into the idle slot, starts it, waits for /health/live, switches
# HAProxy to it and drains the old one — no request is dropped. Exactly one
# slot is enabled at boot (the switch script enables the active one).
#
# Install: /etc/systemd/system/vaultaire@.service, then systemctl daemon-reload.
[Unit]
Description=Vaultaire Storage Engine (slot on port %i)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=user1
Group=user1
WorkingDirectory=/opt/vaultaire
EnvironmentFile=/opt/vaultaire/configs/.env
# The encryption master key (docs/ENCRYPTION.md "Setting the master key";
# WP-R8-1 follow-up A5): sealed on this box with
# `systemd-creds encrypt --with-key=tpm2+host --name=encryption_master_key`,
# decrypted by systemd into $CREDENTIALS_DIRECTORY for this service only. It
# is never in .env. Uncomment after the ceremony; during a master re-key the
# old key is handed over as encryption_master_key_previous the same way.
# A credential that is present but unreadable or malformed refuses the boot.
#LoadCredentialEncrypted=encryption_master_key:/etc/vaultaire/credentials/encryption_master_key.cred
#LoadCredentialEncrypted=encryption_master_key_previous:/etc/vaultaire/credentials/encryption_master_key_previous.cred
# Multipart parts stage in MULTIPART_STAGING_DIR (default /tmp/vaultaire-
# multipart; WP-R3-5). Both slots read it from the one EnvironmentFile and
# run as the same user, so a part staged on one slot is there for the other
# after a switch: keep it that way — no PrivateTmp=, no per-slot value. On
# this box /tmp is a 61 GiB tmpfs (RAM, wiped at boot); the data-disk choice
# is /opt/vaultaire/data/multipart (docs/DEPLOY.md "Multipart staging").
# The slot's port must win over the PORT in .env; EnvironmentFile= overrides
# Environment=, so it is set on the exec line. Each slot runs its own binary.
ExecStart=/bin/sh -c 'PORT=%i exec /opt/vaultaire/bin/vaultaire-%i'
Restart=always
RestartSec=5
LimitNOFILE=1048576
# On SIGTERM the process drains HTTP (30 s, cmd/vaultaire/main.go
# shutdownTimeout), then waits for the long S3 operations it has detached
# from their clients — up to 15 min from each one's start (internal/api
# longOpDrainBound) — then flushes the trackers and closes the DB. This is
# only systemd's outer bound before SIGKILL: above 30 + 900 s plus slack.
# Transfers get their time from vaultaire-switch's drain (up to 10 min, and
# up to 15 min while a long operation runs) before the stop.
TimeoutStopSec=1000
KillMode=mixed

[Install]
WantedBy=multi-user.target

# /etc/sudoers.d/vaultaire-deploy (mode 0440, root:root): what the deploy
# user may run as root without a password. Since 2026-10-06 the deploy is one
# root-owned script (deploy/scripts/vaultaire-switch); the five commands of
# the stop/swap/start era stay for one more cycle and can then go.
user1 ALL=(ALL) NOPASSWD: /usr/local/sbin/vaultaire-switch
user1 ALL=(ALL) NOPASSWD: /bin/systemctl stop vaultaire, /bin/systemctl start vaultaire, /bin/systemctl restart vaultaire, /bin/mv /tmp/vaultaire-linux /opt/vaultaire/bin/vaultaire, /bin/chmod +x /opt/vaultaire/bin/vaultaire

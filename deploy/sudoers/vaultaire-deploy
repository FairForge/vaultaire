# /etc/sudoers.d/vaultaire-deploy (mode 0440, root:root): what the deploy
# user may run as root without a password. Pinned to the exact invocations
# (2026-10-06): sudo matches arguments literally, so no other file or verb is
# reachable (an open `vaultaire-switch` entry let the deploy key copy any root
# file out and delete it). The stop/swap/start commands of the single-unit era
# are gone and vaultaire.service is masked; deploys go through vaultaire-switch.
# Install: visudo -cf <file> && install -o root -g root -m 0440 <file> /etc/sudoers.d/vaultaire-deploy
user1 ALL=(root) NOPASSWD: /usr/local/sbin/vaultaire-switch deploy /tmp/vaultaire-linux, /usr/local/sbin/vaultaire-switch restart, /usr/local/sbin/vaultaire-switch rollback, /usr/local/sbin/vaultaire-switch status
